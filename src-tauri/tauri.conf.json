{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Musahih Pro",
  "version": "0.1.0",
  "identifier": "com.musahih.pro",
  "build": {
    "beforeDevCommand": "cd ../ui && npm run dev",
    "beforeBuildCommand": "cd ../ui && npm run build",
    "frontendDist": "../ui/dist"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "wix": {
        "language": "en-US"
      }
    },
    "shortDescription": "Smart Arabic/English keyboard correction",
    "longDescription": "Musahih Pro auto-detects wrong keyboard layout input and corrects text with privacy-first logic.",
    "icon": ["icons/icon.ico"]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Musahih Pro",
        "width": 980,
        "height": 720,
        "resizable": true
      },
      {
        "label": "notification",
        "title": "Correction Suggestion",
        "width": 320,
        "height": 130,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false
      }
    ]
  }
}
